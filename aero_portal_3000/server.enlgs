# EnLang Native Script (.enlgs)
# Pure Natural EnLang Client-Side Logic & Authentication Engine

function showToast(msg):
    get element "toastMsg" into t
    set text of t to msg
    add class "show" to t
    after 3500 ms call hideToast
close function

function hideToast():
    get element "toastMsg" into t
    remove class "show" from t
close function

function openLoginModal():
    get element "loginModal" into m
    set style display of m to "flex"
close function

function closeLoginModal():
    get element "loginModal" into m
    set style display of m to "none"
close function

function appendTerminal(logLine):
    get element "terminalLog" into term
    set content of term to term.innerHTML + "\n" + logLine
close function

function submitLogin():
    get element "inputUsername" into uElem
    get element "inputPassword" into pElem
    get element "loginErrorMsg" into errElem
    
    set u to uElem.value.trim()
    set p to pElem.value.trim()
    
    if u is equal to "aero" and p is equal to "ok@!1234":
        set style display of errElem to "none"
        closeLoginModal()
        
        get element "statAuth" into statAuth
        get element "userStatusText" into statusText
        get element "navAuthBtn" into navBtn
        
        set text of statAuth to "Unlocked"
        set style color of statAuth to "#34d399"
        set text of statusText to "User: aero (SuperAdmin)"
        set style color of statusText to "#34d399"
        set text of navBtn to "Sign Out"
        add class "btn-danger" to navBtn
        
        showToast("SUCCESS: Welcome back, SuperAdmin aero!")
        appendTerminal("AUTH SUCCESS: User aero authenticated via EnLGDB credentials (aero / ok@!1234)")
    else:
        set text of errElem to "INVALID CREDENTIALS! Required: user = aero, password = ok@!1234"
        set style display of errElem to "block"
        appendTerminal("AUTH FAILURE: Failed login attempt for user")
    close if
close function

function logoutUser():
    get element "statAuth" into statAuth
    get element "userStatusText" into statusText
    get element "navAuthBtn" into navBtn
    
    set text of statAuth to "Locked"
    set style color of statAuth to "#818cf8"
    set text of statusText to "Status: Unauthenticated"
    set style color of statusText to "#9ca3af"
    set text of navBtn to "Sign In"
    remove class "btn-danger" from navBtn
    add class "btn-primary" to navBtn
    
    showToast("Logged out successfully.")
    appendTerminal("AUTH LOGOUT: User aero signed out.")
close function

function triggerAudit():
    appendTerminal("AUDIT EXECUTION: Auditing .enlgf, .enlgd, .enlgs, .enlgdb files...")
    after 600 ms call auditSuccess
close function

function auditSuccess():
    appendTerminal("AUDIT PASS: All 4 EnLang extension files 100% operational on Port 3000")
    showToast("System Audit Complete! All 4 EnLang modules 100% operational.")
close function

# EnLang DOM Event Listener Bindings
on click of "navAuthBtn" call openLoginModal
on click of "authBtn" call openLoginModal
on click of "unlockBtn" call submitLogin
on click of "cancelBtn" call closeLoginModal
on click of "auditBtn" call triggerAudit
