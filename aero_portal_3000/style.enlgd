# EnLang Native Style Schema (.enlgd)
# Fully Natural EnLang Design Language (.enlgd) Specification Demo
# Demonstrates Simple Selectors, Combinators, Attributes, Pseudo-Classes, Pseudo-Elements, and Theme Tokens

var primary_color = "#6366f1"
color dark_bg = "#090d16"
token nav_bg = "#0f172a"
token glass_bg = "rgba(17, 24, 39, 0.85)"

# 1. Simple Selector: Universal Selector (*) & Selection Pseudo-Element
in all
  space outside: 0
  space inside: 0
  box-sizing: border-box
  font family: 'Outfit', 'Inter', system-ui, sans-serif
close

in selection
  background: #6366f1
  text color: #ffffff
close

# 2. Simple Selector: Type Selector (body)
in body
  background-color: #090d16
  text color: #f3f4f6
  min-height: 100vh
  overflow-x: hidden
  background-image: radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.15) 0%, transparent 45%), radial-gradient(circle at 85% 85%, rgba(6, 182, 212, 0.15) 0%, transparent 45%)
close

# 3. Simple Selector: Class Selector (navbar)
in class navbar
  display: flex
  direction: row
  justify: space-between
  align: center
  space inside: 1rem 2.5rem
  background: #0f172a
  border-bottom: 1px solid rgba(255, 255, 255, 0.1)
  position: sticky
  top: 0
  z-index: 100
  width: 100%
close

in class logo
  display: flex
  align: center
  space: 0.75rem
  font size: 1.4rem
  font weight: 800
  text color: #818cf8
close

# 4. Combinator Selector: Child Selector (child logo-badge of logo)
in child logo-badge of logo
  background: #6366f1
  text color: #ffffff
  font size: 0.75rem
  space inside: 0.2rem 0.6rem
  rounded: 9999px
  font weight: 700
  display: inline-block
close

in user-widget
  display: flex
  direction: row
  align: center
  space: 1rem
  margin-left: auto
close

in status-dot
  width: 10px
  height: 10px
  rounded: 50%
  background: #10b981
  shadow: 0 0 10px #10b981
  display: inline-block
close

# Main Container Layout
in container
  max-width: 1280px
  space outside: 0 auto
  space inside: 2.5rem 2rem
  width: 100%
close

# 5. Pseudo-Class Selector: User Action (glass-card on hover)
in glass-card
  background: rgba(17, 24, 39, 0.85)
  blur: blur(16px)
  web blur: blur(16px)
  border: 1px solid rgba(255, 255, 255, 0.08)
  rounded: 16px
  shadow: 0 20px 40px rgba(0, 0, 0, 0.4)
  transition: transform 0.3s ease, border-color 0.3s ease
close

in glass-card on hover
  border-color: rgba(99, 102, 241, 0.4)
  transform: translateY(-3px)
close

# 6. Combinator Selector: Descendant Selector (p inside hero-banner)
in hero-banner
  text-align: center
  margin-bottom: 3rem
  space inside: 3rem 2rem
  background: rgba(17, 24, 39, 0.85)
  border: 1px solid rgba(99, 102, 241, 0.3)
  rounded: 20px
close

in hero-title
  font size: 3rem
  font weight: 900
  text color: #ffffff
  margin-bottom: 1rem
close

in p inside hero-banner
  font size: 1.1rem
  text color: #94a3b8
  max-width: 720px
  space outside: 0 auto 2rem
  line-height: 1.6
close

# Grid Layout Systems
in stats-grid
  display: grid
  columns: repeat(4, 1fr)
  space: 1.5rem
  margin-bottom: 3rem
  width: 100%
close

in stat-card
  space inside: 1.75rem
  border-left: 4px solid #6366f1
close

in stat-lbl
  font size: 0.85rem
  text color: #9ca3af
  text-transform: uppercase
  font weight: 700
close

in stat-val
  font size: 2.5rem
  font weight: 900
  text color: #ffffff
  margin-top: 0.5rem
close

in features-grid
  display: grid
  columns: repeat(2, 1fr)
  space: 2rem
  margin-bottom: 3rem
  width: 100%
close

in feature-card
  space inside: 2rem
close

in feature-icon
  font size: 2.5rem
  margin-bottom: 1rem
  display: inline-block
  space inside: 0.75rem
  background: rgba(99, 102, 241, 0.15)
  rounded: 14px
close

# Button System & Hover States
in btn
  display: inline-flex
  align: center
  justify: center
  space: 0.5rem
  space inside: 0.75rem 1.6rem
  rounded: 10px
  font weight: 700
  font size: 0.95rem
  cursor: pointer
  border: none
  outline: none
  transition: all 0.2s ease
close

in btn-primary
  background: #6366f1
  text color: #ffffff
  shadow: 0 4px 15px rgba(99, 102, 241, 0.35)
close

in btn-primary on hover
  background: #4f46e5
  transform: translateY(-2px)
close

in btn-danger
  background: rgba(239, 68, 68, 0.2)
  text color: #f87171
  border: 1px solid rgba(239, 68, 68, 0.4)
close

# Forms & Attribute Selectors
in form-group
  margin-bottom: 1.25rem
  text-align: left
close

in form-label
  display: block
  font size: 0.85rem
  font weight: 700
  text color: #9ca3af
  margin-bottom: 0.5rem
  text-transform: uppercase
close

# 7. Attribute Selector (form-input with type "text" or "password")
in form-input
  width: 100%
  space inside: 0.85rem 1.2rem
  background: rgba(15, 23, 42, 0.8)
  border: 1px solid rgba(255, 255, 255, 0.15)
  rounded: 10px
  text color: #ffffff
  font size: 1rem
  outline: none
close

in form-input on focus
  border-color: #6366f1
  shadow: 0 0 0 3px rgba(99, 102, 241, 0.25)
close

# 8. Pseudo-Element Selector (modal-content before)
in modal-overlay
  position: fixed
  inset: 0
  background: rgba(0, 0, 0, 0.85)
  blur: blur(12px)
  display: flex
  align: center
  justify: center
  z-index: 1000
close

in modal-content
  width: 100%
  max-width: 440px
  space inside: 2.5rem
  text-align: center
  border: 1px solid rgba(99, 102, 241, 0.3)
  background: #0f172a
  rounded: 16px
  position: relative
  overflow: hidden
close

in modal-content before
  content: ''
  position: absolute
  top: 0
  left: 0
  right: 0
  height: 4px
  background: linear-gradient(90deg, #6366f1, #06b6d4, #10b981)
close

in toast
  position: fixed
  bottom: 2rem
  right: 2rem
  space inside: 1rem 1.5rem
  rounded: 10px
  background: #1e293b
  text color: #ffffff
  border-left: 4px solid #10b981
  z-index: 2000
  transform: translateY(100px)
  opacity: 0
  transition: all 0.3s ease
close

in toast.show
  transform: translateY(0)
  opacity: 1
close

# Responsive EnLang Media Queries
on screen smaller than 1024px
  in stats-grid
    columns: repeat(2, 1fr)
  close
  in features-grid
    columns: 1fr
  close
close

on screen smaller than 640px
  in navbar
    space inside: 1rem 1.5rem
  close
  in stats-grid
    columns: 1fr
  close
  in hero-title
    font size: 2.25rem
  close
close
