# AERO Website Styling (.enlgd)

style all:
    margin: 0
    padding: 0
    box-sizing: "border-box"
    font-family: "Arial, Helvetica, sans-serif"
end style

style html:
    scroll-behavior: "smooth"
end style

style body:
    background-color: "#0f172a"
    color: "white"
end style

style header:
    position: "fixed"
    width: "100%"
    top: "0"
    left: "0"
    background-color: "#111827"
    z-index: 1000
end style

style nav:
    display: "flex"
    justify-content: "space-between"
    align-items: "center"
    padding: "20px 8%"
end style

.logo {
    color: #38bdf8;
}

.nav-links {
    display: flex;
    list-style: none;
}

.nav-links li {
    margin-left: 30px;
}

.nav-links a {
    text-decoration: none;
    color: white;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8;
}

.menu {
    display: none;
    font-size: 30px;
    cursor: pointer;
}

.hero {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
    background: linear-gradient(135deg, #0f172a, #1e3a8a);
}

.hero h1 {
    font-size: 60px;
}

.hero p {
    margin: 20px 0;
    font-size: 20px;
}

style button:
    padding: "15px 35px"
    border: "none"
    background-color: "#38bdf8"
    color: "white"
    font-size: "18px"
    border-radius: "30px"
    cursor: "pointer"
    transition: "0.3s"
end style

button:hover {
    transform: scale(1.08);
    background: #0ea5e9;
}

.section {
    padding: 100px 8%;
    text-align: center;
}

.cards {
    margin-top: 50px;
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}

.card {
    background: #1e293b;
    padding: 30px;
    width: 280px;
    border-radius: 15px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-10px);
    background: #334155;
}

on screen smaller than "768px":
    .nav-links {
        position: absolute;
        top: 70px;
        left: -100%;
        width: 100%;
        background: #111827;
        flex-direction: column;
        transition: 0.4s;
    }

    .nav-links.active {
        left: 0;
    }

    .nav-links li {
        margin: 20px;
    }

    .menu {
        display: block;
    }

    .hero h1 {
        font-size: 40px;
    }
end style
