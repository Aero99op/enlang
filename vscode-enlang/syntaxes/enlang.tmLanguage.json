{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EnLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#control_keywords" },
    { "include": "#declaration_keywords" },
    { "include": "#web_keywords" },
    { "include": "#db_keywords" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.enlang",
          "match": "#.*$"
        },
        {
          "name": "comment.block.enlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.enlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.enlang",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.enlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.enlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.enlang",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "control_keywords": {
      "patterns": [
        {
          "name": "keyword.control.enlang",
          "match": "\\b(if|then|else|elseif|repeat|times|while|for|each|in|match|case|when|default|return|returns|break|continue|try|catch|finally|raise|do|close|end)\\b"
        }
      ]
    },
    "declaration_keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.enlang",
          "match": "\\b(define|set|as|with|using|to|from|import|export|class|interface|implements|extends|public|private|static|async|await)\\b"
        }
      ]
    },
    "web_keywords": {
      "patterns": [
        {
          "name": "keyword.other.web.enlang",
          "match": "\\b(page|title|include|stylesheet|script|create|main|section|div|h1|h2|h3|h4|h5|h6|p|button|input|form|label|table|tr|th|td|ul|ol|li|nav|header|footer|style|theme|media|hover|active|focus|on|click|submit|log|alert|fetch|json|@js)\\b"
        }
      ]
    },
    "db_keywords": {
      "patterns": [
        {
          "name": "keyword.other.db.enlang",
          "match": "\\b(table|columns|columns:|values|insert|record|into|select|all|where|order|by|limit|asc|desc|truncate|drop|add|column|rename|PRIMARY|KEY|AUTOINCREMENT|NOT|NULL|UNIQUE|DEFAULT|FOREIGN|REFERENCES)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.enlang",
          "match": "\\b(plus|minus|times|divided by|is|is not|equals|is greater than|is less than|is greater than or equal to|is less than or equal to|contains|starts with|ends with|and|or|not)\\b"
        },
        {
          "name": "keyword.operator.symbol.enlang",
          "match": "(\\+|\\-|\\*|\\/|=|==|!=|>|<|>=|<=)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.enlang",
          "match": "\\b(text|number|boolean|list|dictionary|array|set|object|void|INTEGER|TEXT|REAL|BLOB|DATETIME|TIMESTAMP|VARCHAR)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "entity.name.function.builtin.enlang",
          "match": "\\b(display|print|read|input|call|length of|type of|convert|format|now|today|random|max|min|sum|average)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.enlang",
          "match": "\\bfunction\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    }
  },
  "scopeName": "source.enlg"
}
