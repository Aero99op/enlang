

set page title to "NEXUS QUANTUM OS — Multi-Page Cyber Platform"

<!-- 1. NAVIGATION BAR (Global Multipage Header) -->
<nav class="nexus-navbar">
    <div class="nexus-logo" onclick="switchNexusPage('home')">
        <div class="nexus-logo-icon">N</div>
        <span>NEXUS <span class="gradient-text">QUANTUM</span></span>
    </div>
    <ul class="nexus-nav-links">
        <li><a class="nexus-nav-item active" id="nav-home" onclick="switchNexusPage('home')">🏠 Home</a></li>
        <li><a class="nexus-nav-item" id="nav-ecosystem" onclick="switchNexusPage('ecosystem')">⚡ Ecosystem</a></li>
        <li><a class="nexus-nav-item" id="nav-dashboard" onclick="switchNexusPage('dashboard')">📊 Live Console</a></li>
        <li><a class="nexus-nav-item" id="nav-marketplace" onclick="switchNexusPage('marketplace')">💎 Marketplace</a></li>
        <li><a class="nexus-nav-item" id="nav-docs" onclick="switchNexusPage('docs')">📖 Developers</a></li>
    </ul>
    <div class="nexus-nav-pill">
        <div class="nexus-dot-live"></div>
        <span>CORE v4.2 ONLINE</span>
    </div>
</nav>

<div class="nexus-app-wrapper">

<!-- PAGE 1: HOME SHOWCASE VIEW (#home-view) -->
<div id="home-view" class="nexus-page-view active-view">
    <div class="hero-wrapper">
        <canvas id="hero-canvas" class="hero-bg-canvas"></canvas>
        <div class="hero-content">
            <div class="hero-badge">✨ DECENTRALIZED QUANTUM COMPUTE MATRIX</div>
            <h1 class="hero-title">Architecting the <span class="gradient-text">Next Century</span> of Cyberspace</h1>
            <p class="hero-subtitle">High-throughput neural synthesis, multi-dimensional encryption, and ultra-low latency mesh node streaming. Engineered with EnLang core engine.</p>
            <div class="hero-actions">
                <button class="btn-primary-nexus" onclick="switchNexusPage('dashboard')">⚡ Launch Live Console</button>
                <button class="btn-secondary-nexus" onclick="switchNexusPage('ecosystem')">🔍 Explore Ecosystem</button>
            </div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card-nexus">
            <div class="stat-value gradient-text" id="stat-nodes">14,290</div>
            <div class="stat-label">Active Quantum Nodes</div>
        </div>
        <div class="stat-card-nexus">
            <div class="stat-value gradient-pink" id="stat-tps">1.42M</div>
            <div class="stat-label">Transactions / Sec</div>
        </div>
        <div class="stat-card-nexus">
            <div class="stat-value gradient-green" id="stat-uptime">99.999%</div>
            <div class="stat-label">Core SLA Uptime</div>
        </div>
        <div class="stat-card-nexus">
            <div class="stat-value gradient-text" id="stat-users">840K+</div>
            <div class="stat-label">Active Developers</div>
        </div>
    </div>

    <div class="section-header-nexus">
        <h2>Built for <span class="gradient-text">Extreme Performance</span></h2>
        <p>Zero friction architecture designed to scale seamlessly across heterogeneous cloud and edge nodes.</p>
    </div>

    <div class="ecosystem-grid">
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🧠</div>
            <h3 class="module-title">Neural Synthesizer</h3>
            <p class="module-desc">Autonomous AI model compiling directly into EnLang native bytecode for microsecond inference speed.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('Neural Synthesizer Initialized!')">Run Diagnostics</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🛡️</div>
            <h3 class="module-title">Quantum Vault</h3>
            <p class="module-desc">Post-quantum lattice encryption protecting distributed state memory and sovereign keys.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('Quantum Vault Key Synchronized')">Inspect Security</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">⚡</div>
            <h3 class="module-title">Hyper-Mesh Network</h3>
            <p class="module-desc">Peer-to-peer WebSockets relay with automatic route optimization and packet prioritization.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('Mesh Routing Path Optimized')">Check Latency</button>
        </div>
    </div>
</div>

<!-- PAGE 2: ECOSYSTEM & MODULES VIEW (#ecosystem-view) -->
<div id="ecosystem-view" class="nexus-page-view">
    <div class="section-header-nexus">
        <h2>Nexus <span class="gradient-text">Ecosystem Modules</span></h2>
        <p>Explore modular building blocks designed for high-scale enterprise applications.</p>
    </div>

    <div class="ecosystem-grid">
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🌌</div>
            <h3 class="module-title">Starlight Engine</h3>
            <p class="module-desc">Real-time WebGL particle physics & rendering pipeline embedded into web components.</p>
            <button class="btn-primary-nexus" style="width: 100%;" onclick="triggerEffect('starlight')">Activate Starlight</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">💾</div>
            <h3 class="module-title">EnLang Memory DB</h3>
            <p class="module-desc">Zero-latency in-memory database transpiled directly from .enlgdb queries.</p>
            <button class="btn-primary-nexus" style="width: 100%;" onclick="triggerEffect('db')">Query In-Memory State</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">📡</div>
            <h3 class="module-title">Orbitron Telemetry</h3>
            <p class="module-desc">Real-time telemetry stream capturing CPU cycles, memory usage, and node heatmaps.</p>
            <button class="btn-primary-nexus" style="width: 100%;" onclick="switchNexusPage('dashboard')">View Live Telemetry</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🔒</div>
            <h3 class="module-title">Sentinel Auth</h3>
            <p class="module-desc">WebAuthn and biometrics authentication suite with edge key verification.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('Sentinel Auth Protocol Verified')">Verify Token</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🚀</div>
            <h3 class="module-title">Hyper Compiler</h3>
            <p class="module-desc">Transpiles EnLang code into WebAssembly and native C for maximum performance.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('WASM Target Ready')">Compile WASM Target</button>
        </div>
        <div class="nexus-module-card">
            <div class="module-icon-wrap">🔮</div>
            <h3 class="module-title">Matrix Bridge</h3>
            <p class="module-desc">Cross-chain and multi-cloud sync engine connecting legacy REST APIs to Nexus Node Mesh.</p>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="showToast('Bridge Handshake Completed')">Test Handshake</button>
        </div>
    </div>
</div>

<!-- PAGE 3: LIVE DASHBOARD VIEW (#dashboard-view) -->
<div id="dashboard-view" class="nexus-page-view">
    <div class="section-header-nexus" style="text-align: left; margin-bottom: 2rem;">
        <h2>Quantum <span class="gradient-text">Console & Telemetry</span></h2>
        <p>Live real-time performance monitoring across global Nexus compute clusters.</p>
    </div>

    <div class="dashboard-grid">
        <div class="dash-panel">
            <div class="dash-title">
                <span>⚡ Real-Time System Meters</span>
                <span class="nexus-nav-pill"><div class="nexus-dot-live"></div> UPDATING LIVE</span>
            </div>

            <div class="meter-group">
                <div class="meter-header">
                    <span>CPU Core Allocation</span>
                    <span id="meter-cpu-val">42%</span>
                </div>
                <div class="meter-bar-track">
                    <div id="meter-cpu-fill" class="meter-bar-fill" style="width: 42%;"></div>
                </div>
            </div>

            <div class="meter-group">
                <div class="meter-header">
                    <span>Memory Allocation (Quantum Buffer)</span>
                    <span id="meter-mem-val">68%</span>
                </div>
                <div class="meter-bar-track">
                    <div id="meter-mem-fill" class="meter-bar-fill fill-purple" style="width: 68%;"></div>
                </div>
            </div>

            <div class="meter-group">
                <div class="meter-header">
                    <span>Mesh Network Throughput</span>
                    <span id="meter-net-val">89%</span>
                </div>
                <div class="meter-bar-track">
                    <div id="meter-net-fill" class="meter-bar-fill fill-green" style="width: 89%;"></div>
                </div>
            </div>

            <div style="margin-top: 2.5rem;">
                <div class="dash-title">
                    <span>💻 Live System Console Stream</span>
                    <button class="btn-secondary-nexus" style="padding: 0.4rem 1rem; font-size: 0.8rem;" onclick="clearTerminalLogs()">Clear Logs</button>
                </div>
                <div class="terminal-window" id="term-logs">
                    <div class="term-line"><span class="term-time">[11:10:02]</span> SYSTEM_INIT: EnLang Core Web Server Initialized on Port 8099</div>
                    <div class="term-line"><span class="term-time">[11:10:05]</span> MESH_NET: Node 0x9f2a connected via TLS 1.3</div>
                    <div class="term-line"><span class="term-time">[11:10:12]</span> QUANTUM_CORE: State synchronized across 14,290 nodes</div>
                </div>
            </div>
        </div>

        <div class="dash-panel">
            <div class="dash-title">
                <span>🎛️ Interactive Controls</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div>
                    <label style="color: var(--text-muted); font-size: 0.9rem; font-weight: 600;">Core Frequency Boost</label>
                    <input type="range" id="freq-slider" min="1" max="10" value="7" style="width: 100%; margin-top: 0.5rem; accent-color: #00f2fe;" oninput="updateCoreFreq(this.value)">
                    <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">
                        <span>1.0 GHz</span>
                        <span id="freq-display" style="color: #00f2fe; font-weight: bold;">3.8 GHz (Turbo)</span>
                        <span>5.0 GHz</span>
                    </div>
                </div>

                <button class="btn-primary-nexus" style="width: 100%;" onclick="triggerManualSync()">⚡ Force Cluster Re-Sync</button>
                <button class="btn-secondary-nexus" style="width: 100%;" onclick="toggleEcoMode()">🌱 Toggle Eco-Saver Mode</button>
                
                <div style="background: rgba(0, 242, 254, 0.05); border: 1px dashed rgba(0, 242, 254, 0.2); padding: 1rem; border-radius: 12px; font-size: 0.85rem; color: var(--text-muted);">
                    ℹ️ <strong>System Notice:</strong> EnLang Web Server running in asynchronous non-blocking event loop mode.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PAGE 4: MARKETPLACE & PRICING VIEW (#marketplace-view) -->
<div id="marketplace-view" class="nexus-page-view">
    <div class="section-header-nexus">
        <h2>Nexus <span class="gradient-text">Cyber Marketplace</span></h2>
        <p>Choose the compute tier that matches your scale. Upgrade or downgrade anytime.</p>
    </div>

    <div class="pricing-grid">
        <div class="pricing-card">
            <h3 class="plan-name">Developer Core</h3>
            <div class="plan-price">$0 <span>/ forever</span></div>
            <ul class="plan-features">
                <li><span style="color:#00f2fe;">✓</span> 10,000 Free Quantum Requests/mo</li>
                <li><span style="color:#00f2fe;">✓</span> Single-Node Mesh Deployment</li>
                <li><span style="color:#00f2fe;">✓</span> Community Discord Support</li>
                <li><span style="color:#00f2fe;">✓</span> Standard SSL & SSL encryption</li>
            </ul>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="purchasePlan('Developer Core')">Get Started Free</button>
        </div>

        <div class="pricing-card featured">
            <div class="featured-badge">MOST POPULAR</div>
            <h3 class="plan-name gradient-text">Quantum Pro</h3>
            <div class="plan-price">$49 <span>/ month</span></div>
            <ul class="plan-features">
                <li><span style="color:#00f2fe;">✓</span> 5,000,000 Quantum Requests/mo</li>
                <li><span style="color:#00f2fe;">✓</span> Multi-Region Auto Failover Nodes</li>
                <li><span style="color:#00f2fe;">✓</span> Real-Time Telemetry & Console API</li>
                <li><span style="color:#00f2fe;">✓</span> 24/7 Priority Support Desk</li>
                <li><span style="color:#00f2fe;">✓</span> Post-Quantum Vault Encryption</li>
            </ul>
            <button class="btn-primary-nexus" style="width: 100%;" onclick="purchasePlan('Quantum Pro')">Deploy Pro Tier</button>
        </div>

        <div class="pricing-card">
            <h3 class="plan-name">Sovereign Enterprise</h3>
            <div class="plan-price">$299 <span>/ month</span></div>
            <ul class="plan-features">
                <li><span style="color:#00f2fe;">✓</span> Unlimited Requests & Bandwidth</li>
                <li><span style="color:#00f2fe;">✓</span> Custom Dedicated On-Prem Clusters</li>
                <li><span style="color:#00f2fe;">✓</span> 99.999% SLA Guarantee</li>
                <li><span style="color:#00f2fe;">✓</span> Dedicated Quantum Engineer</li>
            </ul>
            <button class="btn-secondary-nexus" style="width: 100%;" onclick="purchasePlan('Sovereign Enterprise')">Contact Sales</button>
        </div>
    </div>
</div>

<!-- PAGE 5: DEVELOPERS & DOCS VIEW (#docs-view) -->
<div id="docs-view" class="nexus-page-view">
    <div class="section-header-nexus">
        <h2>EnLang <span class="gradient-text">Developer Center</span></h2>
        <p>Write English syntaxes and compile directly into HTML, CSS, and JS files.</p>
    </div>

    <div style="background: var(--card-bg); border: 1px solid rgba(0,242,254,0.15); border-radius: 20px; padding: 2rem; backdrop-filter: blur(16px); margin-bottom: 2rem;">
        <h3 style="font-size: 1.3rem; margin-bottom: 1rem; color: #fff;">⚡ Syntax Cheatsheet</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            <div style="background: rgba(0,0,0,0.4); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                <h4 style="color: #00f2fe; margin-bottom: 0.5rem;">Frontend (.enlg)</h4>
                <pre style="font-family: monospace; font-size: 0.85rem; color: #94a3b8;">
create button named btn with label "Click"
render layout with btn
</pre>
            </div>
            <div style="background: rgba(0,0,0,0.4); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                <h4 style="color: #ff0080; margin-bottom: 0.5rem;">Styling (.enlgd)</h4>
                <pre style="font-family: monospace; font-size: 0.85rem; color: #94a3b8;">style body:
    background-color: "#060913"
    color: "#ffffff"
end style</pre>
            </div>
            <div style="background: rgba(0,0,0,0.4); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                <h4 style="color: #10b981; margin-bottom: 0.5rem;">Scripting (.enlgs)</h4>
                <pre style="font-family: monospace; font-size: 0.85rem; color: #94a3b8;">when btn clicked do:
    log "Button clicked!"
end</pre>
            </div>
        </div>
    </div>
</div>

</div> <!-- End nexus-app-wrapper -->

<div id="nexus-toast-container" class="nexus-toast">
    <span style="font-size: 1.3rem;">⚡</span>
    <span id="nexus-toast-text">Nexus System Toast Message</span>
</div>

<footer class="nexus-footer">
    <p>Powered by <strong>EnLang Universal Framework</strong> &bull; Zero Boilerplate Machine</p>
    <p style="font-size: 0.8rem; opacity: 0.6;">© 2026 NEXUS Quantum OS. All Rights Reserved.</p>
</footer>
