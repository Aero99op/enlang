# ─────────────────────────────────────────────────────────────
# NEXUS QUANTUM OS — DESIGN SYSTEM & STYLES (.enlgd)
# ─────────────────────────────────────────────────────────────

define variable bg-dark as "#060913"
define variable card-bg as "rgba(13, 19, 36, 0.75)"
define variable accent-cyan as "#00f2fe"
define variable accent-purple as "#7928ca"
define variable accent-pink as "#ff0080"
define variable text-main as "#f1f5f9"
define variable text-muted as "#94a3b8"

style root:
    --bg-dark: #060913;
    --card-bg: rgba(13, 19, 36, 0.75);
    --border-glow: rgba(0, 242, 254, 0.25);
    --accent-cyan: #00f2fe;
    --accent-blue: #4facfe;
    --accent-purple: #7928ca;
    --accent-pink: #ff0080;
    --accent-green: #10b981;
    --text-main: #f1f5f9;
    --text-muted: #94a3b8;
    --font-heading: 'Orbitron', sans-serif;
    --font-body: 'Outfit', sans-serif;
end style

style body:
    background-color: "#060913"
    color: "#f1f5f9"
    font-family: "'Outfit', sans-serif"
    min-height: "100vh"
    margin: "0"
    padding: "0"
    overflow-x: "hidden"
end style

/* ── Typography & Global Utility Classes ── */
.font-orbitron {
    font-family: 'Orbitron', sans-serif;
}

.gradient-text {
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 50%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: shineText 4s linear infinite;
}

.gradient-pink {
    background: linear-gradient(135deg, #ff0080 0%, #7928ca 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.gradient-green {
    background: linear-gradient(135deg, #10b981 0%, #00f2fe 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

@keyframes shineText {
    to { background-position: 200% center; }
}

/* ── Navbar ── */
.nexus-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(6, 9, 19, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 242, 254, 0.15);
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
}

.nexus-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    cursor: pointer;
}

.nexus-logo-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #00f2fe, #7928ca);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    color: #fff;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.5);
}

.nexus-nav-links {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
}

.nexus-nav-item {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nexus-nav-item:hover, .nexus-nav-item.active {
    color: var(--text-main);
    background: rgba(0, 242, 254, 0.1);
    box-shadow: inset 0 0 12px rgba(0, 242, 254, 0.2);
    border: 1px solid rgba(0, 242, 254, 0.3);
}

.nexus-nav-pill {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #10b981;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.nexus-dot-live {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: pulseGlow 1.5s infinite;
}

@keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
}

/* ── Multipage Container & View Switching ── */
.nexus-app-wrapper {
    padding-top: 80px;
    min-height: calc(100vh - 80px);
}

.nexus-page-view {
    display: none;
    animation: fadeInSlide 0.5s ease forwards;
    padding: 3rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
}

.nexus-page-view.active-view {
    display: block;
}

@keyframes fadeInSlide {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ── Hero Section (Home View) ── */
.hero-wrapper {
    position: relative;
    padding: 5rem 2rem 4rem 2rem;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 0%, rgba(0, 242, 254, 0.15) 0%, rgba(6, 9, 19, 0) 70%);
    border: 1px solid rgba(0, 242, 254, 0.15);
    overflow: hidden;
    text-align: center;
    margin-bottom: 4rem;
}

.hero-bg-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 850px;
    margin: 0 auto;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(121, 40, 202, 0.2);
    border: 1px solid rgba(121, 40, 202, 0.4);
    color: #c084fc;
    padding: 0.4rem 1.2rem;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.5px;
}

.hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
}

.hero-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-primary-nexus {
    background: linear-gradient(135deg, #00f2fe, #4facfe);
    color: #060913;
    font-weight: 700;
    padding: 0.9rem 2.2rem;
    border-radius: 12px;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.4);
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary-nexus:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(0, 242, 254, 0.7);
}

.btn-secondary-nexus {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    font-weight: 600;
    padding: 0.9rem 2.2rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 1rem;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
}

.btn-secondary-nexus:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(0, 242, 254, 0.4);
}

/* ── Live Stats Grid ── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
}

.stat-card-nexus {
    background: var(--card-bg);
    border: 1px solid rgba(0, 242, 254, 0.15);
    border-radius: 18px;
    padding: 1.75rem;
    backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.stat-card-nexus:hover {
    border-color: rgba(0, 242, 254, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 242, 254, 0.15);
}

.stat-value {
    font-size: 2.4rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.25rem;
}

.stat-label {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

/* ── Section Header ── */
.section-header-nexus {
    text-align: center;
    margin-bottom: 3.5rem;
}

.section-header-nexus h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
}

.section-header-nexus p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 650px;
    margin: 0 auto;
}

/* ── Cards & Ecosystem Modules Grid ── */
.ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
}

.nexus-module-card {
    background: var(--card-bg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(16px);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

.nexus-module-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #00f2fe, #7928ca);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.nexus-module-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0, 242, 254, 0.35);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 242, 254, 0.15);
}

.nexus-module-card:hover::before {
    opacity: 1;
}

.module-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
}

.module-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #fff;
}

.module-desc {
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
}

/* ── Interactive Dashboard View ── */
.dashboard-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
}

@media (max-width: 992px) {
    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

.dash-panel {
    background: var(--card-bg);
    border: 1px solid rgba(0, 242, 254, 0.15);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(16px);
}

.dash-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

/* Real-Time Meter Bars */
.meter-group {
    margin-bottom: 1.5rem;
}

.meter-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.meter-bar-track {
    height: 12px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

.meter-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #00f2fe, #4facfe);
    border-radius: 6px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.5);
}

.fill-purple {
    background: linear-gradient(90deg, #7928ca, #ff0080);
    box-shadow: 0 0 12px rgba(255, 0, 128, 0.5);
}

.fill-green {
    background: linear-gradient(90deg, #10b981, #00f2fe);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.5);
}

/* Live Terminal Log */
.terminal-window {
    background: #020408;
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: 12px;
    padding: 1.25rem;
    font-family: 'Consolas', 'Fira Code', monospace;
    font-size: 0.85rem;
    color: #00f2fe;
    height: 220px;
    overflow-y: auto;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8);
}

.term-line {
    margin-bottom: 0.4rem;
    line-height: 1.4;
    word-break: break-all;
}

.term-time {
    color: #64748b;
    margin-right: 0.5rem;
}

/* ── Marketplace / Pricing Cards ── */
.pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.pricing-card {
    background: var(--card-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    backdrop-filter: blur(16px);
    text-align: center;
    position: relative;
    transition: all 0.3s ease;
}

.pricing-card.featured {
    border-color: rgba(0, 242, 254, 0.5);
    background: radial-gradient(circle at 50% 0%, rgba(0, 242, 254, 0.15) 0%, var(--card-bg) 80%);
    box-shadow: 0 0 40px rgba(0, 242, 254, 0.2);
    transform: scale(1.03);
}

.featured-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #00f2fe, #4facfe);
    color: #060913;
    font-weight: 800;
    font-size: 0.75rem;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
}

.plan-price {
    font-size: 3rem;
    font-weight: 900;
    color: #fff;
    margin-bottom: 1.5rem;
}

.plan-price span {
    font-size: 1rem;
    color: var(--text-muted);
    font-weight: 400;
}

.plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    text-align: left;
}

.plan-features li {
    padding: 0.6rem 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.plan-features li check {
    color: #00f2fe;
    font-weight: bold;
}

/* ── Interactive Modal / Toast ── */
.nexus-toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: rgba(13, 19, 36, 0.95);
    border: 1px solid #00f2fe;
    color: #fff;
    padding: 1rem 1.5rem;
    border-radius: 14px;
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 40px rgba(0, 242, 254, 0.3);
    z-index: 2000;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.nexus-toast.show-toast {
    transform: translateY(0);
    opacity: 1;
}

/* ── Footer ── */
.nexus-footer {
    margin-top: 6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3rem 2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.nexus-footer p {
    margin-bottom: 0.5rem;
}
