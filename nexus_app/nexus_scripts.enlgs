# ─────────────────────────────────────────────────────────────
# NEXUS QUANTUM OS — JAVASCRIPT LOGIC (.enlgs)
# ─────────────────────────────────────────────────────────────

# 1. Multi-Page Router Switcher
function switchNexusPage with args pageId do:
    log "Switching page to: " + pageId
    
    # Hide all page views
    set pages to document.querySelectorAll(".nexus-page-view")
    set navItems to document.querySelectorAll(".nexus-nav-item")
    
    pages.forEach(function(p) {
        p.classList.remove("active-view");
    });
    
    navItems.forEach(function(n) {
        n.classList.remove("active");
    });
    
    # Show active page view
    set targetPage to document.getElementById(pageId + "-view")
    if targetPage do:
        targetPage.classList.add("active-view");
    end
    
    set targetNav to document.getElementById("nav-" + pageId)
    if targetNav do:
        targetNav.classList.add("active");
    end

    # Scroll top
    window.scrollTo({top: 0, behavior: 'smooth'});
end

# 2. Toast Notification Function
function showToast with args msg do:
    set toast to document.getElementById("nexus-toast-container")
    set textEl to document.getElementById("nexus-toast-text")
    if toast and textEl do:
        textEl.innerText = msg;
        toast.classList.add("show-toast");
        setTimeout(function() {
            toast.classList.remove("show-toast");
        }, 3200);
    end
end

# 3. Interactive Plan Purchase Simulator
function purchasePlan with args planName do:
    showToast("🎉 Selected Plan: " + planName + "! Initializing Gateway...");
    setTimeout(function() {
        showToast("✅ Gateway Ready. Welcome to " + planName + " Tier!");
    }, 1500);
end

# 4. Live Telemetry Simulators
function updateMeters do:
    set cpuFill to document.getElementById("meter-cpu-fill")
    set cpuVal to document.getElementById("meter-cpu-val")
    set memFill to document.getElementById("meter-mem-fill")
    set memVal to document.getElementById("meter-mem-val")
    set netFill to document.getElementById("meter-net-fill")
    set netVal to document.getElementById("meter-net-val")

    if cpuFill and cpuVal do:
        set newCpu to Math.floor(Math.random() * 35) + 30;
        cpuFill.style.width = newCpu + "%";
        cpuVal.innerText = newCpu + "%";
    end

    if memFill and memVal do:
        set newMem to Math.floor(Math.random() * 20) + 60;
        memFill.style.width = newMem + "%";
        memVal.innerText = newMem + "%";
    end

    if netFill and netVal do:
        set newNet to Math.floor(Math.random() * 15) + 80;
        netFill.style.width = newNet + "%";
        netVal.innerText = newNet + "%";
    end
end

every 3000 ms do:
    updateMeters();
end

function addTerminalLog with args message do:
    set logsContainer to document.getElementById("term-logs")
    if logsContainer do:
        set now to new Date();
        set timeStr = "[" + now.toTimeString().split(" ")[0] + "]";
        set div to document.createElement("div");
        div.className = "term-line";
        div.innerHTML = '<span class="term-time">' + timeStr + '</span> ' + message;
        logsContainer.appendChild(div);
        logsContainer.scrollTop = logsContainer.scrollHeight;
    end
end

every 4500 ms do:
    set msgs to [
        "QUANTUM_NODE: Packet 0x4f81 verified",
        "ENLANG_VM: Garbage collection freed 14MB memory",
        "SECURITY_SENTINEL: Zero handshake anomalies detected",
        "MESH_RELAY: Latency benchmark: 0.8ms average",
        "TELEMETRY: System state snapshot stored to vault"
    ];
    set randomMsg to msgs[Math.floor(Math.random() * msgs.length)];
    addTerminalLog(randomMsg);
end

function clearTerminalLogs do:
    set logsContainer to document.getElementById("term-logs")
    if logsContainer do:
        logsContainer.innerHTML = '<div class="term-line"><span class="term-time">[CLEARED]</span> Logs reset by user.</div>';
    end
    showToast("Terminal Logs Cleared");
end

function updateCoreFreq with args val do:
    set display to document.getElementById("freq-display")
    if display do:
        set ghz to (val * 0.5).toFixed(1);
        display.innerText = ghz + " GHz (" + (val > 6 ? "Turbo" : "Normal") + ")";
    end
end

function triggerManualSync do:
    showToast("⚡ Force Re-Sync Sent to 14,290 Nodes!");
    addTerminalLog("USER_ACTION: Manual Cluster Re-Sync Triggered");
end

function toggleEcoMode do:
    showToast("🌱 Eco Saver Mode Toggled");
    addTerminalLog("SYSTEM_CONFIG: Power profile updated to EcoSaver");
end

function triggerEffect with args type do:
    showToast("✨ Activated Module Effect: " + type.toUpperCase());
    addTerminalLog("MODULE_LOAD: Launched module plugin (" + type + ")");
end

# 5. Canvas Particle Matrix Engine
when window load do:
    set canvas to document.getElementById("hero-canvas")
    if not canvas do:
        return;
    end
    
    set ctx to canvas.getContext("2d")
    
    function resizeCanvas do:
        canvas.width = canvas.parentElement.clientWidth;
        canvas.height = canvas.parentElement.clientHeight;
    end
    
    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);
    
    set particles to []
    set particleCount to 60;
    
    for i from 0 to 60 do:
        particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 0.8,
            vy: (Math.random() - 0.5) * 0.8,
            radius: Math.random() * 2 + 1,
            color: Math.random() > 0.5 ? 'rgba(0, 242, 254, ' : 'rgba(121, 40, 202, ',
            alpha: Math.random() * 0.6 + 0.2
        });
    end
    
    function drawParticles do:
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        for i from 0 to particles.length do:
            set p to particles[i];
            p.x += p.vx;
            p.y += p.vy;
            
            if p.x < 0 or p.x > canvas.width do: p.vx *= -1; end
            if p.y < 0 or p.y > canvas.height do: p.vy *= -1; end
            
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = p.color + p.alpha + ')';
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#00f2fe';
            ctx.fill();
            
            for j from i + 1 to particles.length do:
                set p2 to particles[j];
                set dx to p.x - p2.x;
                set dy to p.y - p2.y;
                set dist to Math.sqrt(dx * dx + dy * dy);
                
                if dist < 120 do:
                    ctx.beginPath();
                    ctx.moveTo(p.x, p.y);
                    ctx.lineTo(p2.x, p2.y);
                    ctx.strokeStyle = 'rgba(0, 242, 254, ' + (1 - dist / 120) * 0.25 + ')';
                    ctx.lineWidth = 0.6;
                    ctx.stroke();
                end
            end
        end
        
        requestAnimationFrame(drawParticles);
    end
    
    drawParticles();
end
