# server.enlgsb — Pure Natural English Node.js Server Backend (.enlgsb)

connect to sqlite database "app.db" as db

start backend server on port 8000

create api route "/api/users" with method GET:
    execute query "SELECT * FROM UserRecords" on db and store in users
    return json response with users

create api route "/api/users" with method POST:
    get request body parameter "name" and store in username
    get request body parameter "email" and store in useremail
    get request body parameter "age" and store in userage
    insert record into UserRecords with values username, useremail, userage
    return json response with message "User added to Database!"
