# Ultra-Simplified Spam Email Classifier in Pure EnLang (.enlg)

display "============================================================"
display "       ENLANG NATURAL SPAM EMAIL CLASSIFIER        "
display "============================================================"
display ""

# 1. Load Dataset
define dataset_path as "d:/enlangg/examples/spam email labeling/emails.csv"
display "[INFO] Loading dataset from: " + dataset_path

define emails as []
define labels as []
load dataset dataset_path into emails and labels

display "[INFO] Dataset loaded with " + len(emails) + " samples."
display ""

# 2. Train Model with 80/20 Train-Test Split
display "[INFO] Training Spam Classifier with 80 20 Train-Test Split..."
train spam classifier using emails and labels with 80 20 split and store in spam_model

display "[SUCCESS] Model Trained! 20% Test Accuracy: " + spam_model.accuracy + "%"
display ""

# 3. Classify Function
function classify_email using mail_text:
    classify mail_text using spam_model and store in prediction
    display prediction

# 4. Run Sample Predictions
display "============================================================"
display " SAMPLE EMAIL CLASSIFICATION DEMO "
display "============================================================"
display ""

display "Sample 1: Win $1,000,000 lottery cash prize!"
call classify_email using "CONGRATULATIONS! You won a $1,000,000 lottery cash prize! Click here immediately to claim your money!"
display ""

display "Sample 2: Project status update meeting"
call classify_email using "Subject: Project status update meeting scheduled for tomorrow at 10 AM in Conference Room B."
display ""
