function min_window with s and t:
    set t_count to create map
    set required_chars to 0
    for each char in t:
        if t_count has key char then:
            set t_count[char] to t_count[char] + 1
        else:
            set t_count[char] to 1
            set required_chars to required_chars + 1

    set left to 0
    set min_len to infinity
    set min_window to ""
    set formed_chars to 0
    set window_counts to create map

    for each right from 0 to length of s - 1:
        set character to s[right]
        if window_counts has key character then:
            set window_counts[character] to window_counts[character] + 1
        else:
            set window_counts[character] to 1

        if t_count has key character and window_counts[character] == t_count[character] then:
            set formed_chars to formed_chars + 1

        while formed_chars == required_chars and left <= right:
            set character to s[left]

            if right - left + 1 < min_len then:
                set min_len to right - left + 1
                set min_window to s[left:right + 1]

            if window_counts has key character then:
                set window_counts[character] to window_counts[character] - 1       
            else:
                set window_counts[character] to 0

            if t_count has key character and window_counts[character] < t_count[character] then:
                set formed_chars to formed_chars - 1

            set left to left + 1

    return min_window

set s to ask "Enter string s: "
set t to ask "Enter string t: "
set result to call min_window with s and t
display result