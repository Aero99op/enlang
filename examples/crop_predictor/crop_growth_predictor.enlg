# High-level helper for farmer soil input recommendation
def recommend_crop(n, p, k, temp, hum, ph, rain):
    input_df = pd.DataFrame([{
        'N': n, 'P': p, 'K': k,
        'temperature': temp, 'humidity': hum,
        'ph': ph, 'rainfall': rain
    }])
    input_scaled = _enlg_scaler.transform(input_df.values)
    best_crop = _enlg_model_randomforest.predict(input_scaled)[0]
    probs = _enlg_model_randomforest.predict_proba(input_scaled)[0]
    classes = _enlg_model_randomforest.classes_
    top_prob = round(max(probs) * 100, 1)

    print(f"Soil & Weather Inputs:")
    print(f"  N: {n} | P: {p} | K: {k} | Temp: {temp}°C | Humidity: {hum}% | pH: {ph} | Rainfall: {rain}mm")
    print(f"  >>> RECOMMENDED CROP: [{best_crop.upper()}] (Confidence: {top_prob}%)")
    print("-" * 65)

print("[FARM SAMPLE 1] High Moisture & Rainfall Heavy Soil:")
recommend_crop(n=90, p=45, k=40, temp=24.5, hum=85.0, ph=6.5, rain=240.0)

print("[FARM SAMPLE 2] High Potassium & Dry Climate Soil:")
recommend_crop(n=30, p=70, k=80, temp=18.5, hum=17.0, ph=7.2, rain=75.0)

print("[FARM SAMPLE 3] High Nitrogen & Warm Humid Soil:")
recommend_crop(n=120, p=45, k=20, temp=25.0, hum=80.0, ph=6.8, rain=90.0)

print("[FARM SAMPLE 4] Tropical Fruit Conditions (High N & P):")
recommend_crop(n=105, p=80, k=50, temp=27.0, hum=80.0, ph=6.0, rain=110.0)
