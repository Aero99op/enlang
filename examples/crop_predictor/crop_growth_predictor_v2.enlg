python:
def recommend(n, p, k, temp, hum, ph, rain, label="Sample"):
    import pandas as pd
    row = pd.DataFrame([{'N': n, 'P': p, 'K': k,
                         'temperature': temp, 'humidity': hum,
                         'ph': ph, 'rainfall': rain}])
    scaled = scaler.transform(row.values)
    crop = rf.predict(scaled)[0]
    conf = round(max(rf.predict_proba(scaled)[0]) * 100, 1)
    print(f"[{label}] N:{n} P:{p} K:{k} T:{temp}°C H:{hum}% pH:{ph} Rain:{rain}mm")
    print(f"  >> RECOMMENDED CROP: [{crop.upper()}]  (Confidence: {conf}%)")
    print("-" * 65)

recommend(90,  45, 40, 24.5, 85.0, 6.5, 240.0, "Heavy Rainfall Soil")
recommend(30,  70, 80, 18.5, 17.0, 7.2,  75.0, "Dry Climate High-K Soil")
recommend(120, 45, 20, 25.0, 80.0, 6.8,  90.0, "High Nitrogen Warm Soil")
recommend(105, 80, 50, 27.0, 80.0, 6.0, 110.0, "Tropical Fruit Conditions")
recommend(70,  30, 25, 22.0, 65.0, 6.5,  80.0, "Balanced Temperate Soil")
