# ── STEP 2: Engineer Labels via Python Block (complex custom logic) ───────────

display "[STEP 2] Engineering Escalation Labels from news content..."

python:
import warnings
warnings.filterwarnings('ignore')

def assign_escalation(row):
    kw = str(row.get('_keyword', '')).lower()
    ct = str(row.get('content', ''))[:400].lower()
    title = str(row.get('title', '')).lower()

    high_kw = ['war', 'attack', 'nuclear', 'hormuz', 'midnight hammer',
               'twelve-day', 'fordow', 'israel war', 'khamenei death', 'strike', 'invasion']
    low_kw  = ['ceasefire', 'peace', 'deal', 'diplomacy', 'negotiations',
               'sanctions', 'cooperation', 'agreement', 'dialogue', 'trump']

    hs = sum(1 for k in high_kw if k in kw or k in title)
    ls = sum(1 for k in low_kw  if k in kw or k in title)
    hs += sum(0.5 for k in high_kw if k in ct)
    ls += sum(0.5 for k in low_kw  if k in ct)

    return 1 if hs > ls else 0

df['escalation'] = df.apply(assign_escalation, axis=1)

# Build combined feature text
df['combined'] = (
    df['title'].fillna('') + ' ' +
    df['_keyword'].fillna('') + ' ' +
    df['content'].fillna('').str[:300]
)

X = df['combined'].tolist()
y = df['escalation'].tolist()

esc_count = sum(y)
de_count  = len(y) - esc_count
print(f"[INFO] Escalation: {esc_count} | De-escalation: {de_count} | Total: {len(y)}")
end python

