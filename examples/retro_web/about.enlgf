# about.enlgf — About & Manifesto Page in EnLang Markup (.enlgf)

page title "CYBER-RETRO v2.0 // System Manifesto"

include stylesheet "style.css"
create script with src "app.js"

create header with class "retro-header":
    create a with class "brand-logo" with text "SYS://CYBER_RETRO" with href "index.html"
    create nav:
        create ul with class "nav-links":
            create li:
                create a with class "nav-link" with text "01.HOME" with href "index.html"
            close li
            create li:
                create a with class "nav-link active" with text "02.ABOUT" with href "about.html"
            close li
            create li:
                create a with class "nav-link" with text "03.GALLERY" with href "gallery.html"
            close li
            create li:
                create a with class "nav-link" with text "04.GUESTBOOK" with href "guestbook.html"
            close li
        close ul
    close nav
    create div with class "retro-controls":
        create button with class "btn-retro" with id "btnToggleCrt" with text "[CRT: ON/OFF]"
    close div
close header

create main with class "container":
    create div with class "terminal-card":
        create div with class "terminal-header":
            create span with class "dot dot-red"
            close span
            create span with class "dot dot-yellow"
            close span
            create span with class "dot dot-green"
            close span
            create span with text "  about_manifesto.md"
            close span
        close div
        create h1 with class "hero-title" with text "ARCHITECTURAL MANIFESTO"
        create p with class "hero-subtitle" with text "> The philosophy behind natural language web engineering."
        
        create section:
            create h3 with class "card-title" with text "01. DETERMINISTIC MULTI-TARGET COMPILATION"
            create p with class "card-desc" with text "EnLang proves that natural human language can serve as a primary programming medium. By transpiling directly to W3C-standard HTML5, CSS3, JavaScript ES6+, and ANSI SQL, EnLang enables developers to write complete full-stack web applications without relying on heavy non-deterministic LLM APIs or black-box runtime dependencies."
            
            create h3 with class "card-title" with text "02. ZERO DEPENDENCY FOOTPRINT"
            create p with class "card-desc" with text "Every webpage generated by EnLang sub-transpilers (.enlgf, .enlgd, .enlgs) is lightweight, zero-framework, and runs natively in any browser. No 500 server errors, no 404 broken routes, and 100% offline compatibility."

            create h3 with class "card-title" with text "03. RETRO CYBER AESTHETIC DESIGN SYSTEM"
            create p with class "card-desc" with text "Combining vintage 80s CRT monitor glow with modern 2026 glassmorphism UI elements, dark mode obsidian surfaces, and Web Audio synthesizers."
        close section

        create div with class "retro-controls":
            create a with class "btn-retro" with text "VIEW ART GALLERY >" with href "gallery.html"
        close div
    close div
close main

create footer with class "retro-footer":
    create p with text "SYSTEM STATUS: 100% OPERATIONAL // BUILT WITH ENLANG v2.0 // SPANDAN PRAYAS PATRA © 2026"
close footer
