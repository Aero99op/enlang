# gallery.enlgf — Gallery Page in EnLang Markup (.enlgf)

page title "CYBER-RETRO v2.0 // Arcade Gallery"

include stylesheet "style.css"
create script with src "app.js"

create header with class "retro-header":
    create a with class "brand-logo" with text "SYS://CYBER_RETRO" with href "index.html"
    create nav:
        create ul with class "nav-links":
            create li:
                create a with class "nav-link" with text "01.HOME" with href "index.html"
            close li
            create li:
                create a with class "nav-link" with text "02.ABOUT" with href "about.html"
            close li
            create li:
                create a with class "nav-link active" with text "03.GALLERY" with href "gallery.html"
            close li
            create li:
                create a with class "nav-link" with text "04.GUESTBOOK" with href "guestbook.html"
            close li
        close ul
    close nav
    create div with class "retro-controls":
        create button with class "btn-retro" with id "btnToggleCrt" with text "[CRT: ON/OFF]"
    close div
close header

create main with class "container":
    create div with class "terminal-card":
        create div with class "terminal-header":
            create span with class "dot dot-red"
            close span
            create span with class "dot dot-yellow"
            close span
            create span with class "dot dot-green"
            close span
            create span with text "  gallery_arcade.viewer"
            close span
        close div
        create h1 with class "hero-title" with text "RETRO ARCADE SHOWCASE"
        create p with class "hero-subtitle" with text "> Visual aesthetic artwork generated for EnLang retro UI showcase."
        
        create div with class "hero-grid":
            create div:
                create image with src "assets/arcade.png", alt "Retro Arcade Station Artwork"
            close div
            create div:
                create h3 with class "card-title" with text "SYSTEM ARCHITECTURE 1988"
                create p with class "card-desc" with text "Inspired by vintage CRT computer terminals, analog synthesizers, and early cybernetic control panels."
                create button with class "btn-retro" with id "btnBeep" with text "🔊 PLAY SYNTH SOUND"
            close div
        close div
    close div
close main

create footer with class "retro-footer":
    create p with text "SYSTEM STATUS: 100% OPERATIONAL // BUILT WITH ENLANG v2.0 // SPANDAN PRAYAS PATRA © 2026"
close footer
