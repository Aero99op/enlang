# guestbook.enlgf — Guestbook & Contact Page in EnLang Markup (.enlgf)

page title "CYBER-RETRO v2.0 // Guestbook Terminal"

include stylesheet "style.css"
create script with src "app.js"

create header with class "retro-header":
    create a with class "brand-logo" with text "SYS://CYBER_RETRO" with href "index.html"
    create nav:
        create ul with class "nav-links":
            create li:
                create a with class "nav-link" with text "01.HOME" with href "index.html"
            close li
            create li:
                create a with class "nav-link" with text "02.ABOUT" with href "about.html"
            close li
            create li:
                create a with class "nav-link" with text "03.GALLERY" with href "gallery.html"
            close li
            create li:
                create a with class "nav-link active" with text "04.GUESTBOOK" with href "guestbook.html"
            close li
        close ul
    close nav
    create div with class "retro-controls":
        create button with class "btn-retro" with id "btnToggleCrt" with text "[CRT: ON/OFF]"
    close div
close header

create main with class "container":
    create div with class "hero-grid":
        create div with class "terminal-card":
            create div with class "terminal-header":
                create span with class "dot dot-red"
                close span
                create span with class "dot dot-yellow"
                close span
                create span with class "dot dot-green"
                close span
                create span with text "  sign_guestbook.sh"
                close span
            close div
            create h1 with class "hero-title" with text "SIGN RETRO GUESTBOOK"
            create p with class "hero-subtitle" with text "> Leave your signature in the encrypted LocalStorage log!"
            
            create form with id "guestbookForm":
                create div with class "form-group":
                    create label with class "form-label" with text "HANDLE / USERNAME:"
                    create input with type "text" with id "inputName" with class "form-input" with placeholder "e.g. CyberSamurai_99"
                close div
                create div with class "form-group":
                    create label with class "form-label" with text "MESSAGE TRANSMISSION:"
                    create textarea with id "inputMessage" with class "form-input" with placeholder "Enter your retro transmission here..."
                close div
                create button with class "btn-retro" with type "submit" with text "TRANSMIT MESSAGE >"
            close form
        close div

        create div with class "terminal-card":
            create div with class "terminal-header":
                create span with class "dot dot-green"
                close span
                create span with text "  guestbook_entries.log"
                close span
            close div
            create h3 with class "card-title" with text "LIVE TRANSMISSION LOGS:"
            create div with id "guestbookList"
            close div
        close div
    close div
close main

create footer with class "retro-footer":
    create p with text "SYSTEM STATUS: 100% OPERATIONAL // BUILT WITH ENLANG v2.0 // SPANDAN PRAYAS PATRA © 2026"
close footer
