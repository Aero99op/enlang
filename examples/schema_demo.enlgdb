# schema_demo.enlgdb — EnLang Database Engine Schema (.enlgdb)
# Enterprise Multi-Table E-Commerce Database Definition in Natural EnLang

# 1. Users Table
define table users with columns id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, email TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP

# 2. Products Table
define table products with columns id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, price REAL NOT NULL, stock INTEGER DEFAULT 0, category TEXT DEFAULT 'General', created_at DATETIME DEFAULT CURRENT_TIMESTAMP

# 3. Orders Table
define table orders with columns id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, total_amount REAL NOT NULL, status TEXT DEFAULT 'Pending', created_at DATETIME DEFAULT CURRENT_TIMESTAMP

# 4. Order Items Table
define table order_items with columns id INTEGER PRIMARY KEY AUTOINCREMENT, order_id INTEGER NOT NULL, product_id INTEGER NOT NULL, quantity INTEGER NOT NULL, unit_price REAL NOT NULL

# 5. Reviews Table
define table reviews with columns id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, product_id INTEGER NOT NULL, rating INTEGER CHECK(rating >= 1 AND rating <= 5), comment TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP

# Index Declarations
CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);
CREATE INDEX IF NOT EXISTS idx_orders_user_id ON orders(user_id);
CREATE INDEX IF NOT EXISTS idx_products_category ON products(category);

# Seed Sample Data
insert into users columns (username, email, password_hash) values ('spandan_admin', 'spandan@enlang.org', '$pbkdf2$hash_value_99')
insert into products columns (title, price, stock, category) values ('EnLang Master Course', 99.99, 100, 'Books')
insert into orders columns (user_id, total_amount, status) values (1, 99.99, 'Completed')
insert into order_items columns (order_id, product_id, quantity, unit_price) values (1, 1, 1, 99.99)
insert into reviews columns (user_id, product_id, rating, comment) values (1, 1, 5, 'Top tier natural English programming system!')

# Queries
select all from users where id = 1
select all from products where category = 'Books' order by price desc limit 10
