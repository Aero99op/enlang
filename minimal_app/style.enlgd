# ──────────────────────────────────────────────────────────
# STYLE.ENLGD — Minimalist Design System (.enlgd)
# ──────────────────────────────────────────────────────────

define theme with primary "#6366f1", background "#090d16", accent "#38bdf8"

import font "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&display=swap"

style all:
    margin: 0
    padding: 0
    box-sizing: border-box
end style

style body:
    background-color: #090d16
    color: #f8fafc
    font-family: 'Inter', sans-serif
    line-height: 1.6
    min-height: 100vh
    overflow-x: hidden
end style

.header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 13, 22, 0.8);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #ffffff;
}

.nav-links {
    display: flex;
    gap: 2.5rem;
}

.nav-links a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

.nav-links a:hover {
    color: #ffffff;
}

style button:
    background: transparent
    color: #ffffff
    border: 1px solid rgba(255, 255, 255, 0.2)
    padding: 0.6rem 1.4rem
    border-radius: 9999px
    font-size: 0.85rem
    font-weight: 500
    cursor: pointer
    transition: all 0.3s ease
end style

button:hover {
    background: #ffffff;
    color: #090d16;
    border-color: #ffffff;
}

section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 2rem;
}

.section-header p {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #6366f1;
    margin-bottom: 2rem;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
}

.work-card {
    background: rgba(18, 24, 38, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
    transition: transform 0.4s ease, border-color 0.4s ease;
}

.work-card:hover {
    transform: translateY(-8px);
    border-color: rgba(99, 102, 241, 0.4);
}

.work-card h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: #ffffff;
}

.work-card p {
    color: #94a3b8;
    font-size: 0.95rem;
}

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
}

.metric-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 3rem 1.5rem;
    border-radius: 16px;
}

.metric-card h2 {
    font-size: 3rem;
    font-weight: 700;
    color: #38bdf8;
    margin-bottom: 0.5rem;
}

.metric-card p {
    color: #64748b;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.connect-box {
    max-width: 600px;
    margin: 0 auto;
    background: rgba(18, 24, 38, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3rem;
    border-radius: 20px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

form label {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 0.3rem;
    display: block;
}

form input {
    width: 100%;
    background: rgba(9, 13, 22, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s ease;
}

form input:focus {
    border-color: #6366f1;
}

.footer {
    text-align: center;
    padding: 3rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #475569;
    font-size: 0.85rem;
}

on screen smaller than "768px":
    .navbar {
        flex-direction: column;
        gap: 1rem;
    }
    .metrics-grid {
        grid-template-columns: 1fr;
    }
end style
