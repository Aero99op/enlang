# Earth Portal UI Design & Stylesheet (.enlgd)

define theme with primary "#3b82f6", background "#050814", accent "#10b981"

style body:
    background-color: "#050814"
    color: "#f3f4f6"
    font-family: "'Outfit', sans-serif"
    min-height: "100vh"
    margin: "0"
    padding: "0"
end style

style body:
    background-image: "radial-gradient(circle at 50% 10%, rgba(30, 58, 138, 0.35) 0%, transparent 60%), radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.15) 0%, transparent 50%)"
end style

style .earth-app-wrapper:
    width: "100%"
    max-width: "1280px"
    margin: "0 auto"
    padding: "1.5rem 1rem"
    display: "flex"
    flex-direction: "column"
    min-height: "100vh"
end style

style .terra-header:
    display: "flex"
    align-items: "center"
    justify-content: "space-between"
    background: "rgba(15, 23, 42, 0.75)"
    backdrop-filter: "blur(16px)"
    border: "1px solid rgba(255, 255, 255, 0.1)"
    border-radius: "20px"
    padding: "0.9rem 1.6rem"
    margin-bottom: "2rem"
    box-shadow: "0 10px 30px rgba(0, 0, 0, 0.5)"
end style

style .header-brand:
    display: "flex"
    align-items: "center"
    gap: "0.6rem"
end style

style .brand-icon:
    font-size: "1.8rem"
end style

style .brand-title:
    font-size: "1.35rem"
    font-weight: "800"
    letter-spacing: "1px"
    color: "#ffffff"
end style

style .brand-badge:
    font-size: "0.7rem"
    font-weight: "700"
    background: "linear-gradient(135deg, #3b82f6, #10b981)"
    color: "#ffffff"
    padding: "0.2rem 0.6rem"
    border-radius: "12px"
    margin-left: "0.4rem"
    vertical-align: "middle"
end style

style .terra-nav:
    display: "flex"
    gap: "0.5rem"
    flex-wrap: "wrap"
end style

style .nav-btn:
    background: "rgba(255, 255, 255, 0.05)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    color: "#9ca3af"
    padding: "0.55rem 1.1rem"
    border-radius: "14px"
    font-family: "'Outfit', sans-serif"
    font-size: "0.9rem"
    font-weight: "600"
    cursor: "pointer"
    transition: "all 0.25s ease"
    display: "inline-flex"
    align-items: "center"
    gap: "0.4rem"
end style

style .nav-btn:hover:
    background: "rgba(59, 130, 246, 0.18)"
    color: "#60a5fa"
    border-color: "rgba(96, 165, 250, 0.4)"
    transform: "translateY(-2px)"
end style

style .nav-btn.active:
    background: "linear-gradient(135deg, #2563eb, #1d4ed8)"
    color: "#ffffff"
    border-color: "#60a5fa"
    box-shadow: "0 4px 16px rgba(37, 99, 235, 0.4)"
end style

style .terra-main:
    flex: "1"
    width: "100%"
end style

style .page-section:
    display: "none"
    opacity: "0"
    transform: "translateY(12px)"
    transition: "all 0.35s cubic-bezier(0.4, 0, 0.2, 1)"
end style

style .page-section.active-page:
    display: "block"
    opacity: "1"
    transform: "translateY(0)"
end style

style .hero-banner:
    display: "flex"
    align-items: "center"
    justify-content: "space-between"
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "28px"
    padding: "3rem 2.5rem"
    margin-bottom: "2.5rem"
    gap: "2rem"
    position: "relative"
    overflow: "hidden"
end style

style .hero-text:
    flex: "1"
    max-width: "600px"
end style

style .hero-tag:
    font-size: "0.8rem"
    font-weight: "700"
    letter-spacing: "2px"
    color: "#60a5fa"
    display: "block"
    margin-bottom: "0.6rem"
end style

style .hero-text h1:
    font-size: "2.8rem"
    font-weight: "800"
    line-height: "1.15"
    margin-bottom: "1rem"
    background: "linear-gradient(to right, #ffffff, #93c5fd, #34d399)"
    -webkit-background-clip: "text"
    -webkit-text-fill-color: "transparent"
end style

style .hero-text p:
    font-size: "1.05rem"
    color: "#9ca3af"
    line-height: "1.6"
    margin-bottom: "1.8rem"
end style

style .hero-cta:
    display: "flex"
    gap: "1rem"
    flex-wrap: "wrap"
end style

style .btn-primary:
    background: "linear-gradient(135deg, #2563eb, #059669)"
    color: "#ffffff"
    border: "none"
    padding: "0.85rem 1.6rem"
    border-radius: "16px"
    font-family: "'Outfit', sans-serif"
    font-size: "0.95rem"
    font-weight: "700"
    cursor: "pointer"
    box-shadow: "0 6px 20px rgba(37, 99, 235, 0.35)"
    transition: "transform 0.2s ease, box-shadow 0.2s ease"
end style

style .btn-primary:hover:
    transform: "translateY(-2px)"
    box-shadow: "0 8px 26px rgba(37, 99, 235, 0.5)"
end style

style .btn-secondary:
    background: "rgba(255, 255, 255, 0.06)"
    color: "#e5e7eb"
    border: "1px solid rgba(255, 255, 255, 0.15)"
    padding: "0.85rem 1.6rem"
    border-radius: "16px"
    font-family: "'Outfit', sans-serif"
    font-size: "0.95rem"
    font-weight: "600"
    cursor: "pointer"
    transition: "background 0.2s ease, transform 0.2s ease"
end style

style .btn-secondary:hover:
    background: "rgba(255, 255, 255, 0.12)"
    transform: "translateY(-2px)"
end style

style .globe-container:
    position: "relative"
    display: "flex"
    align-items: "center"
    justify-content: "center"
end style

style #globe-canvas:
    border-radius: "50%"
    box-shadow: "0 0 50px rgba(59, 130, 246, 0.4), inset -20px -20px 40px rgba(0,0,0,0.8)"
end style

style .section-title:
    font-size: "1.6rem"
    font-weight: "800"
    margin-bottom: "1.5rem"
    color: "#ffffff"
end style

style .stats-grid:
    display: "grid"
    grid-template-columns: "repeat(auto-fit, minmax(180px, 1fr))"
    gap: "1.2rem"
    margin-bottom: "2.5rem"
end style

style .stat-card:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "20px"
    padding: "1.4rem 1.2rem"
    text-align: "center"
    transition: "transform 0.25s ease, border-color 0.25s ease"
end style

style .stat-card:hover:
    transform: "translateY(-4px)"
    border-color: "rgba(59, 130, 246, 0.4)"
end style

style .stat-icon:
    font-size: "1.8rem"
    margin-bottom: "0.5rem"
end style

style .stat-val:
    font-size: "1.25rem"
    font-weight: "800"
    color: "#60a5fa"
    margin-bottom: "0.25rem"
end style

style .stat-lbl:
    font-size: "0.82rem"
    color: "#9ca3af"
    font-weight: "500"
end style

style .features-row:
    display: "grid"
    grid-template-columns: "repeat(auto-fit, minmax(280px, 1fr))"
    gap: "1.4rem"
    margin-bottom: "2rem"
end style

style .feature-box:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "22px"
    padding: "1.6rem"
end style

style .feature-emoji:
    font-size: "2rem"
    display: "block"
    margin-bottom: "0.8rem"
end style

style .feature-box h3:
    font-size: "1.2rem"
    color: "#34d399"
    margin-bottom: "0.5rem"
end style

style .feature-box p:
    font-size: "0.9rem"
    color: "#9ca3af"
    line-height: "1.5"
    margin: "0"
end style

style .page-header:
    margin-bottom: "2rem"
end style

style .page-header h2:
    font-size: "2.2rem"
    font-weight: "800"
    color: "#ffffff"
    margin-bottom: "0.4rem"
end style

style .page-header p:
    font-size: "1rem"
    color: "#9ca3af"
end style

style .layers-interactive-container:
    display: "grid"
    grid-template-columns: "280px 1fr"
    gap: "1.5rem"
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "24px"
    padding: "1.8rem"
end style

style .layer-selector-buttons:
    display: "flex"
    flex-direction: "column"
    gap: "0.8rem"
end style

style .layer-btn:
    background: "rgba(255, 255, 255, 0.04)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    color: "#d1d5db"
    padding: "1rem 1.2rem"
    border-radius: "16px"
    font-family: "'Outfit', sans-serif"
    font-size: "0.95rem"
    font-weight: "600"
    text-align: "left"
    cursor: "pointer"
    transition: "all 0.2s ease"
end style

style .layer-btn:hover:
    background: "rgba(59, 130, 246, 0.15)"
    color: "#60a5fa"
end style

style .layer-btn.active:
    background: "linear-gradient(135deg, #2563eb, #1d4ed8)"
    color: "#ffffff"
    border-color: "#60a5fa"
end style

style .layer-detail-box:
    background: "rgba(0, 0, 0, 0.35)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "18px"
    padding: "1.8rem"
end style

style .atmos-layout:
    display: "grid"
    grid-template-columns: "1fr 380px"
    gap: "1.8rem"
end style

style .atmos-layers-column:
    display: "flex"
    flex-direction: "column"
    gap: "1rem"
end style

style .atmos-card:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-left-width: "5px"
    border-radius: "16px"
    padding: "1.3rem 1.5rem"
end style

style .atmos-head:
    display: "flex"
    justify-content: "space-between"
    align-items: "center"
    margin-bottom: "0.5rem"
end style

style .atmos-name:
    font-size: "1.1rem"
    font-weight: "700"
    color: "#ffffff"
end style

style .atmos-alt:
    font-size: "0.82rem"
    font-weight: "600"
    background: "rgba(255, 255, 255, 0.1)"
    padding: "0.2rem 0.6rem"
    border-radius: "10px"
    color: "#93c5fd"
end style

style .atmos-card p:
    font-size: "0.9rem"
    color: "#9ca3af"
    line-height: "1.5"
    margin: "0"
end style

style .atmos-composition-card:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "20px"
    padding: "1.6rem"
end style

style .atmos-composition-card h3:
    font-size: "1.2rem"
    color: "#ffffff"
    margin-bottom: "1.4rem"
end style

style .gas-bar-container:
    display: "flex"
    flex-direction: "column"
    gap: "1.2rem"
    margin-bottom: "1.6rem"
end style

style .gas-info:
    display: "flex"
    justify-content: "space-between"
    font-size: "0.9rem"
    font-weight: "600"
    margin-bottom: "0.4rem"
end style

style .gas-progress:
    height: "10px"
    background: "rgba(0, 0, 0, 0.4)"
    border-radius: "6px"
    overflow: "hidden"
end style

style .gas-fill:
    height: "100%"
    border-radius: "6px"
    transition: "width 0.8s ease"
end style

style .atmos-note:
    background: "rgba(59, 130, 246, 0.1)"
    border: "1px solid rgba(59, 130, 246, 0.2)"
    border-radius: "14px"
    padding: "1rem"
    font-size: "0.85rem"
    color: "#93c5fd"
    line-height: "1.5"
end style

style .continents-grid:
    display: "grid"
    grid-template-columns: "repeat(auto-fit, minmax(260px, 1fr))"
    gap: "1.2rem"
    margin-bottom: "2.5rem"
end style

style .geo-card:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "20px"
    padding: "1.4rem"
    position: "relative"
    transition: "transform 0.2s ease"
end style

style .geo-card:hover:
    transform: "translateY(-3px)"
    border-color: "rgba(59, 130, 246, 0.3)"
end style

style .geo-badge:
    position: "absolute"
    top: "1.2rem"
    right: "1.2rem"
    font-size: "0.75rem"
    font-weight: "800"
    background: "rgba(59, 130, 246, 0.2)"
    color: "#60a5fa"
    padding: "0.2rem 0.5rem"
    border-radius: "8px"
end style

style .geo-card h3:
    font-size: "1.2rem"
    color: "#ffffff"
    margin-bottom: "0.5rem"
end style

style .geo-card p:
    font-size: "0.88rem"
    color: "#9ca3af"
    line-height: "1.4"
    margin-bottom: "1rem"
end style

style .geo-stats:
    font-size: "0.8rem"
    color: "#34d399"
    font-weight: "600"
end style

style .subsection-title:
    font-size: "1.4rem"
    color: "#ffffff"
    margin-bottom: "1rem"
end style

style .oceans-row:
    display: "grid"
    grid-template-columns: "repeat(auto-fit, minmax(200px, 1fr))"
    gap: "1rem"
end style

style .ocean-box:
    background: "rgba(15, 23, 42, 0.5)"
    border: "1px solid rgba(255, 255, 255, 0.06)"
    border-radius: "16px"
    padding: "1.2rem"
end style

style .ocean-box h4:
    font-size: "1.05rem"
    color: "#60a5fa"
    margin-bottom: "0.4rem"
end style

style .ocean-box p:
    font-size: "0.84rem"
    color: "#9ca3af"
    margin: "0"
    line-height: "1.4"
end style

style .interactive-dual-grid:
    display: "grid"
    grid-template-columns: "1fr 1fr"
    gap: "1.8rem"
end style

style .tool-card:
    background: "rgba(15, 23, 42, 0.6)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    border-radius: "24px"
    padding: "1.8rem"
end style

style .tool-card h3:
    font-size: "1.3rem"
    color: "#ffffff"
    margin-bottom: "0.6rem"
end style

style .tool-card p:
    font-size: "0.9rem"
    color: "#9ca3af"
    margin-bottom: "1.2rem"
end style

style .calc-input-group:
    margin-bottom: "1.5rem"
end style

style .calc-input-group label:
    display: "block"
    font-size: "0.85rem"
    font-weight: "600"
    color: "#d1d5db"
    margin-bottom: "0.4rem"
end style

style .weight-results-grid:
    display: "grid"
    grid-template-columns: "1fr 1fr"
    gap: "0.8rem"
end style

style .weight-card:
    background: "rgba(0, 0, 0, 0.3)"
    border: "1px solid rgba(255, 255, 255, 0.06)"
    border-radius: "14px"
    padding: "0.9rem"
    display: "flex"
    justify-content: "space-between"
    align-items: "center"
end style

style .w-planet:
    font-size: "0.9rem"
    font-weight: "600"
    color: "#e5e7eb"
end style

style .w-val:
    font-size: "1.05rem"
    font-weight: "800"
    color: "#34d399"
end style

style .quiz-q:
    font-size: "1.05rem"
    font-weight: "700"
    color: "#ffffff"
    margin-bottom: "1rem"
    line-height: "1.4"
end style

style .quiz-options:
    display: "flex"
    flex-direction: "column"
    gap: "0.6rem"
    margin-bottom: "1rem"
end style

style .quiz-opt-btn:
    background: "rgba(255, 255, 255, 0.04)"
    border: "1px solid rgba(255, 255, 255, 0.08)"
    color: "#d1d5db"
    padding: "0.8rem 1rem"
    border-radius: "14px"
    font-family: "'Outfit', sans-serif"
    font-size: "0.9rem"
    text-align: "left"
    cursor: "pointer"
    transition: "all 0.2s ease"
end style

style .quiz-opt-btn:hover:
    background: "rgba(59, 130, 246, 0.15)"
    color: "#60a5fa"
end style

style .quiz-opt-btn.correct:
    background: "rgba(16, 185, 129, 0.2)"
    border-color: "#10b981"
    color: "#34d399"
end style

style .quiz-opt-btn.wrong:
    background: "rgba(239, 68, 68, 0.2)"
    border-color: "#ef4444"
    color: "#fca5a5"
end style

style .quiz-feedback:
    font-size: "0.9rem"
    font-weight: "600"
    min-height: "1.5rem"
end style

style .quiz-score-box:
    margin-top: "1.2rem"
    font-size: "0.95rem"
    font-weight: "700"
    color: "#60a5fa"
    text-align: "right"
end style

style .terra-footer:
    text-align: "center"
    padding: "2rem 0 1rem 0"
    color: "#6b7280"
    font-size: "0.85rem"
    border-top: "1px solid rgba(255, 255, 255, 0.05)"
    margin-top: "3rem"
end style

on screen smaller than "900px":
    style .hero-banner:
        flex-direction: "column"
        text-align: "center"
    end style

    style .layers-interactive-container:
        grid-template-columns: "1fr"
    end style

    style .atmos-layout:
        grid-template-columns: "1fr"
    end style

    style .interactive-dual-grid:
        grid-template-columns: "1fr"
    end style
