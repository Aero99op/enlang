@on <frontend>

# Page Title
page title "TERRA — Planet Earth Interactive Portal"

# Outer Wrapper
print("""<div class="earth-app-wrapper">""")

# Top Navigation Bar
print("""
<header class="terra-header">
    <div class="header-brand">
        <span class="brand-icon">🌍</span>
        <span class="brand-title">TERRA <span class="brand-badge">EARTH 360°</span></span>
    </div>
    <nav class="terra-nav">
        <button id="nav-overview" class="nav-btn active" onclick="switchPage('overview')"><span class="icon">🌐</span> Overview</button>
        <button id="nav-layers" class="nav-btn" onclick="switchPage('layers')"><span class="icon">🌋</span> Core Layers</button>
        <button id="nav-atmosphere" class="nav-btn" onclick="switchPage('atmosphere')"><span class="icon">☁️</span> Atmosphere</button>
        <button id="nav-continents" class="nav-btn" onclick="switchPage('continents')"><span class="icon">🗺️</span> Continents</button>
        <button id="nav-gravity" class="nav-btn" onclick="switchPage('gravity')"><span class="icon">🧮</span> Gravity & Quiz</button>
    </nav>
</header>
""")

# Main Content Multi-Page Container
print("""<main class="terra-main">""")

# PAGE 1: OVERVIEW
print("""
<section id="page-overview" class="page-section active-page">
    <div class="hero-banner">
        <div class="hero-text">
            <span class="hero-tag">THE THIRD PLANET FROM THE SUN</span>
            <h1>Welcome to Planet Earth</h1>
            <p>The only known celestial body in the universe confirmed to harbor life, dynamic oceans, and a protective magnetosphere.</p>
            <div class="hero-cta">
                <button class="btn-primary" onclick="switchPage('layers')">Explore Internal Structure →</button>
                <button class="btn-secondary" onclick="switchPage('gravity')">Test Weight on Other Worlds 🚀</button>
            </div>
        </div>
        <div class="globe-container">
            <canvas id="globe-canvas" width="340" height="340"></canvas>
            <div class="globe-shadow"></div>
        </div>
    </div>

    <h2 class="section-title">Key Planetary Metrics</h2>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📏</div>
            <div class="stat-val">12,742 km</div>
            <div class="stat-lbl">Equatorial Diameter</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🚀</div>
            <div class="stat-val">107,200 km/h</div>
            <div class="stat-lbl">Orbital Speed Around Sun</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">💧</div>
            <div class="stat-val">70.8 %</div>
            <div class="stat-lbl">Surface Covered by Water</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⏳</div>
            <div class="stat-val">4.54 Billion Years</div>
            <div class="stat-lbl">Estimated Age of Earth</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⚖️</div>
            <div class="stat-val">5.972 × 10²⁴ kg</div>
            <div class="stat-lbl">Total Mass</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <div class="stat-val">8.1 Billion</div>
            <div class="stat-lbl">Human Population</div>
        </div>
    </div>

    <div class="features-row">
        <div class="feature-box">
            <span class="feature-emoji">🧲</span>
            <h3>Geodynamo Magnetic Shield</h3>
            <p>Generated by fluid motion in the molten outer core, Earth's magnetosphere deflects lethal solar wind and cosmic radiation, protecting our atmosphere.</p>
        </div>
        <div class="feature-box">
            <span class="feature-emoji">🌊</span>
            <h3>Dynamic Hydrosphere</h3>
            <p>Earth contains 1.386 billion cubic kilometers of water. Over 96.5% resides in oceans, driving planetary climate and weather cycles.</p>
        </div>
        <div class="feature-box">
            <span class="feature-emoji">🌿</span>
            <h3>Thriving Biosphere</h3>
            <p>Home to over 8.7 million species of flora and fauna, Earth's unique distance (Goldilocks zone) allows liquid water to exist indefinitely.</p>
        </div>
    </div>
</section>
""")

# PAGE 2: INTERNAL LAYERS
print("""
<section id="page-layers" class="page-section">
    <div class="page-header">
        <h2>Journey to the Center of the Earth</h2>
        <p>Click on any layer below to inspect its thickness, temperature, composition, and physical state.</p>
    </div>

    <div class="layers-interactive-container">
        <div class="layer-selector-buttons">
            <button class="layer-btn active" onclick="selectLayer('crust')">1. Continental & Oceanic Crust</button>
            <button class="layer-btn" onclick="selectLayer('mantle')">2. Upper & Lower Mantle</button>
            <button class="layer-btn" onclick="selectLayer('outer-core')">3. Liquid Outer Core</button>
            <button class="layer-btn" onclick="selectLayer('inner-core')">4. Solid Inner Core</button>
        </div>

        <div id="layer-detail-box" class="layer-detail-box">
            <!-- Dynamic JS injected layer content -->
        </div>
    </div>
</section>
""")

# PAGE 3: ATMOSPHERE
print("""
<section id="page-atmosphere" class="page-section">
    <div class="page-header">
        <h2>Earth's Atmospheric Shield & Atmospheric Layers</h2>
        <p>The blanket of gases held by Earth's gravity that creates air pressure, absorbs ultraviolet solar radiation, and reduces temperature extremes.</p>
    </div>

    <div class="atmosphere-layout">
        <div class="atmos-layers-column">
            <div class="atmos-card" style="border-left-color: #60a5fa;">
                <div class="atmos-head">
                    <span class="atmos-name">1. Troposphere</span>
                    <span class="atmos-alt">0 to 12 km</span>
                </div>
                <p>Lowest layer containing 75% of atmospheric mass and 99% of water vapor. All weather phenomena (clouds, rain, storms) occur here.</p>
            </div>
            <div class="atmos-card" style="border-left-color: #38bdf8;">
                <div class="atmos-head">
                    <span class="atmos-name">2. Stratosphere</span>
                    <span class="atmos-alt">12 to 50 km</span>
                </div>
                <p>Contains the vital Ozone Layer (O₃) which absorbs harmful UV radiation from the sun. Commercial jet aircraft cruise in the lower stratosphere.</p>
            </div>
            <div class="atmos-card" style="border-left-color: #818cf8;">
                <div class="atmos-head">
                    <span class="atmos-name">3. Mesosphere</span>
                    <span class="atmos-alt">50 to 85 km</span>
                </div>
                <p>Coldest layer of Earth's atmosphere (-90°C). Most meteors burn up in this layer upon entering Earth's atmosphere due to friction.</p>
            </div>
            <div class="atmos-card" style="border-left-color: #c084fc;">
                <div class="atmos-head">
                    <span class="atmos-name">4. Thermosphere</span>
                    <span class="atmos-alt">85 to 600 km</span>
                </div>
                <p>High-energy X-rays and UV radiation cause temperatures to reach 2,000°C. Home to the International Space Station (ISS) and breathtaking Auroras.</p>
            </div>
            <div class="atmos-card" style="border-left-color: #f472b6;">
                <div class="atmos-head">
                    <span class="atmos-name">5. Exosphere</span>
                    <span class="atmos-alt">600 to 10,000 km</span>
                </div>
                <p>The outermost atmosphere fringe where atoms gradually leak into outer space. Weather and GPS communication satellites orbit here.</p>
            </div>
        </div>

        <div class="atmos-composition-card">
            <h3>Dry Air Composition by Volume</h3>
            <div class="gas-bar-container">
                <div class="gas-item">
                    <div class="gas-info"><span>Nitrogen (N₂)</span> <span>78.08%</span></div>
                    <div class="gas-progress"><div class="gas-fill" style="width: 78.08%; background: #3b82f6;"></div></div>
                </div>
                <div class="gas-item">
                    <div class="gas-info"><span>Oxygen (O₂)</span> <span>20.95%</span></div>
                    <div class="gas-progress"><div class="gas-fill" style="width: 20.95%; background: #10b981;"></div></div>
                </div>
                <div class="gas-item">
                    <div class="gas-info"><span>Argon (Ar)</span> <span>0.93%</span></div>
                    <div class="gas-progress"><div class="gas-fill" style="width: 5%; background: #f59e0b;"></div></div>
                </div>
                <div class="gas-item">
                    <div class="gas-info"><span>Carbon Dioxide (CO₂) & Trace</span> <span>0.04%</span></div>
                    <div class="gas-progress"><div class="gas-fill" style="width: 2%; background: #ef4444;"></div></div>
                </div>
            </div>
            <div class="atmos-note">
                💡 <strong>Greenhouse Effect:</strong> Trace gases (CO₂, H₂O, CH₄) trap thermal energy radiating from Earth's surface, maintaining an average planetary temperature of 15°C instead of a freezing -18°C.
            </div>
        </div>
    </div>
</section>
""")

# PAGE 4: CONTINENTS & OCEANS
print("""
<section id="page-continents" class="page-section">
    <div class="page-header">
        <h2>Global Geography & Ocean Basins</h2>
        <p>Discover Earth's 7 continents and 5 major ocean bodies forming our global biome.</p>
    </div>

    <div class="continents-grid">
        <div class="geo-card">
            <div class="geo-badge">AS</div>
            <h3>Asia</h3>
            <p>Largest continent by land area and population. Home to Mount Everest (8,848m), the highest point on Earth.</p>
            <div class="geo-stats"><span>Area: 44.58M km²</span> | <span>Pop: 4.7 Billion</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">AF</div>
            <h3>Africa</h3>
            <p>Second largest continent, rich in biodiversity. Houses the Nile River and the vast Sahara Desert.</p>
            <div class="geo-stats"><span>Area: 30.37M km²</span> | <span>Pop: 1.4 Billion</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">NA</div>
            <h3>North America</h3>
            <p>Spans from Arctic tundra to tropical isthmuses. Contains the Grand Canyon and Great Lakes system.</p>
            <div class="geo-stats"><span>Area: 24.71M km²</span> | <span>Pop: 592 Million</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">SA</div>
            <h3>South America</h3>
            <p>Houses the Amazon Rainforest (Earth's lungs) and the Andes mountain range spanning 7,000 km.</p>
            <div class="geo-stats"><span>Area: 17.84M km²</span> | <span>Pop: 434 Million</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">AN</div>
            <h3>Antarctica</h3>
            <p>Coldest, driest, and windiest continent. Holds 70% of the world's freshwater frozen in ice sheets.</p>
            <div class="geo-stats"><span>Area: 14.20M km²</span> | <span>Pop: ~1,000 (Research)</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">EU</div>
            <h3>Europe</h3>
            <p>Rich cultural history and dense river networks stretching from Atlantic coast to the Ural mountains.</p>
            <div class="geo-stats"><span>Area: 10.18M km²</span> | <span>Pop: 746 Million</span></div>
        </div>
        <div class="geo-card">
            <div class="geo-badge">OC</div>
            <h3>Australia / Oceania</h3>
            <p>Smallest continent surrounded by Indian and Pacific Oceans. Home to the Great Barrier Reef.</p>
            <div class="geo-stats"><span>Area: 8.60M km²</span> | <span>Pop: 45 Million</span></div>
        </div>
    </div>

    <h3 class="subsection-title">The 5 Ocean Basins</h3>
    <div class="oceans-row">
        <div class="ocean-box">
            <h4>🌊 Pacific Ocean</h4>
            <p>Largest ocean covering 165M km². Contains the Mariana Trench (10,994m deep).</p>
        </div>
        <div class="ocean-box">
            <h4>⛵ Atlantic Ocean</h4>
            <p>Second-largest ocean separating Americas from Europe/Africa. Features Mid-Atlantic Ridge.</p>
        </div>
        <div class="ocean-box">
            <h4>🏝️ Indian Ocean</h4>
            <p>Third-largest ocean, warmest sea temperature, key historical maritime trade route.</p>
        </div>
        <div class="ocean-box">
            <h4>🐧 Southern Ocean</h4>
            <p>Encircles Antarctica with cold northward flowing Antarctic Circumpolar Current.</p>
        </div>
        <div class="ocean-box">
            <h4>❄️ Arctic Ocean</h4>
            <p>Smallest and shallowest ocean, covered by sea ice throughout most of the year.</p>
        </div>
    </div>
</section>
""")

# PAGE 5: GRAVITY & QUIZ
print("""
<section id="page-gravity" class="page-section">
    <div class="page-header">
        <h2>Interplanetary Weight Calculator & Earth Quiz</h2>
        <p>Calculate your weight under different planetary gravity fields and test your Earth science knowledge!</p>
    </div>

    <div class="interactive-dual-grid">
        <!-- Weight Calculator -->
        <div class="tool-card">
            <h3>🧮 Gravity Weight Converter</h3>
            <p>Enter your Earth weight (in kg) to see how heavy you'd feel across the Solar System:</p>
            
            <div class="calc-input-group">
                <label for="user-weight-input">Weight on Earth (kg):</label>
                <input type="number" id="user-weight-input" value="70" min="1" max="500" oninput="calculateWeights()" class="form-input">
            </div>

            <div id="weight-results-grid" class="weight-results-grid">
                <!-- Injected via JS -->
            </div>
        </div>

        <!-- Interactive Quiz Challenge -->
        <div class="tool-card">
            <h3>🧠 Earth Science Quick Quiz</h3>
            <div id="quiz-container">
                <div id="quiz-question" class="quiz-q">Question loading...</div>
                <div id="quiz-options" class="quiz-options"></div>
                <div id="quiz-feedback" class="quiz-feedback"></div>
                <button id="quiz-next-btn" class="btn-primary" style="margin-top: 1rem; display: none;" onclick="nextQuestion()">Next Question →</button>
            </div>
            <div id="quiz-score-box" class="quiz-score-box">Score: <span id="score-num">0</span> / 4</div>
        </div>
    </div>
</section>
""")

print("""</main>""")

